{
  "title": "Développements limités",
  "labelA": "Fonction",
  "labelB": "DL",
  "fixedSide": false,
  "cards": [

    { "a": "$e^x$",                "b": "$1 + x + \\dfrac{x^2}{2} + \\dfrac{x^3}{6} + o(x^3)$" },

    { "a": "$\\cos x$",            "b": "$1 - \\dfrac{x^2}{2} + \\dfrac{x^4}{24} + o(x^5)$" },
    { "a": "$\\cosh x$",           "b": "$1 + \\dfrac{x^2}{2} + \\dfrac{x^4}{24} + o(x^5)$" },

    { "a": "$\\sin x$",            "b": "$x - \\dfrac{x^3}{6} + \\dfrac{x^5}{120} + o(x^6)$" },
    { "a": "$\\sinh x$",           "b": "$x + \\dfrac{x^3}{6} + \\dfrac{x^5}{120} + o(x^6)$" },

    { "a": "$\\dfrac{1}{1-x}$",    "b": "$1 + x + x^2 + x^3 + o(x^3)$" },
    { "a": "$\\dfrac{1}{1+x}$",    "b": "$1 - x + x^2 - x^3 + o(x^3)$" },
    { "a": "$\\ln(1+x)$",          "b": "$x - \\dfrac{x^2}{2} + \\dfrac{x^3}{3} + o(x^3)$" },
    { "a": "$\\arctan x$",         "b": "$x - \\dfrac{x^3}{3} + \\dfrac{x^5}{5} + o(x^6)$" },

    { "a": "$(1+x)^{\\alpha}$",    "b": "$1 + \\alpha x + \\dfrac{\\alpha(\\alpha-1)}{2}x^2 + o(x^2)$" },

    { "a": "$\\tan x$",            "b": "$x + \\dfrac{x^3}{3} + o(x^4)$" }

  ]
}
